archie.biotron.it {
    encode gzip zstd

    handle /api/* {
        reverse_proxy backend_nginx:8080
    }

    handle /admin/* {
        reverse_proxy backend_nginx:8080
    }

    handle /static/* {
        reverse_proxy backend_nginx:8080
    }

    handle /media/* {
        reverse_proxy backend_nginx:8080
    }

    handle {
        reverse_proxy frontend:8080
    }
}

portal.biotron.it {
    encode gzip zstd

    handle /api/* {
        reverse_proxy backend_nginx:8080
    }

    handle /admin/* {
        reverse_proxy backend_nginx:8080
    }

    handle /static/* {
        reverse_proxy backend_nginx:8080
    }

    handle /media/* {
        reverse_proxy backend_nginx:8080
    }

    handle {
        reverse_proxy frontend-portal:8080
    }
}
