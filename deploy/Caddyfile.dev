:80 {
    encode gzip zstd
    handle /api/* {
        reverse_proxy backend_nginx:8080
    }
    handle /admin/* {
        reverse_proxy backend_nginx:8080
    }
    handle /static/* {
        reverse_proxy backend_nginx:8080
    }
    handle /media/* {
        reverse_proxy backend_nginx:8080
    }
    handle {
        reverse_proxy frontend:8080 {
            header_up Host {host}
        }
    }
}

:8081 {
    encode gzip zstd
    handle /api/* {
        reverse_proxy backend_nginx:8080
    }
    handle {
        reverse_proxy frontend-portal:8080 {
            header_up Host {host}
        }
    }
}
