# Template di configurazione — copia in .env.dev / .env.prod e compila con
# valori reali. QUESTO FILE NON DEVE MAI CONTENERE SEGRETI VERI: è pensato
# per essere versionato/condiviso, a differenza di .env.dev/.env.prod
# (già esclusi da .gitignore, ma vanno esclusi anche da qualunque zip
# manuale del progetto condiviso con terzi — es. per audit o supporto).
#
# Fix 2.7 (audit 2026-07): un archivio del progetto condiviso con terzi
# conteneva .env.dev con SECRET_KEY, password DB, chiave di cifratura e
# webhook Teams reali. Se quei valori sono stati usati fuori da una macchina
# locale, vanno ruotati:
# - DJANGO_SECRET_KEY: rigenerabile liberamente, invalida le sessioni attive.
# - POSTGRES_PASSWORD / DB_PASSWORD: cambiare sia lato Postgres sia qui.
# - FIELD_ENCRYPTION_KEY: la più delicata. Ruotarla SENZA una procedura di
#   re-encryption rende illeggibili tutti i dati cifrati già salvati
#   (password WiFi, credenziali inventario, VPN, ecc.). Va pianificata come
#   migrazione dedicata (decrypt con la chiave vecchia, re-encrypt con la
#   nuova), non un semplice cambio di variabile.
# - SERVICENOW_TEAMS_WEBHOOK_URL: rigenerare il webhook in Teams.

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_DB=archie
POSTGRES_USER=archie
POSTGRES_PASSWORD=changeme
DB_HOST=db
DB_PORT=5432
DB_NAME=archie
DB_USER=archie
DB_PASSWORD=changeme
DATABASE_URL=

# ── Django core ───────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=changeme-generate-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# ── Sicurezza / cookie (vedi anche core/checks.py, fix 2.12) ──────────────
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_SSL_REDIRECT=1
# NON impostare (0.9.0): un cookie condiviso tra archie.biotron.it e
# portal.biotron.it rompe lo scope per cliente degli utenti dual-profile,
# che dipende dall'ambito di login fissato nella sessione — vedi il
# commento in backend/config/settings.py.
DJANGO_SESSION_COOKIE_DOMAIN=

# ── Timeout inattività (0.9.0) ──────────────────────────────────────────────
# Differenziati per ambito: Portal (dati clinici, clienti esterni AUSL
# Bologna) più stretto di Archie principale (staff interno). Enforced
# server-side da core.middleware.SessionIdleTimeoutMiddleware — non basta
# più il solo timer client-side, che un refresh di pagina bypassava.
# lock: oltre questo tempo di inattività serve reinserire la password
# (LockScreen), ma la sessione resta valida (nessuna perdita del login).
DJANGO_SESSION_IDLE_LOCK_SECONDS_ARCHIE=900
DJANGO_SESSION_IDLE_LOCK_SECONDS_PORTAL=600
# logout: oltre questo tempo la sessione viene invalidata, serve login pieno.
DJANGO_SESSION_IDLE_LOGOUT_SECONDS_ARCHIE=3600
DJANGO_SESSION_IDLE_LOGOUT_SECONDS_PORTAL=1800

# ── Cifratura campi sensibili ──────────────────────────────────────────────
# Chiave Fernet (44 caratteri base64). Generarla con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=changeme-fernet-key

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Altro ───────────────────────────────────────────────────────────────────
TIME_ZONE=Europe/Rome
RUN_COLLECTSTATIC=1
RUN_MIGRATIONS=0
MAINTENANCE_ALERT_EMAIL=
SERVICENOW_TEAMS_WEBHOOK_URL=
